pipeline {
    agent {
        label 'build-jenkins-base'
    }

    stages {
        stage('Guard: manual main-branch run only') {
            steps {
                script {
                    if (currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').isEmpty()) {
                        error('Helm deploy must be started manually from the Jenkins UI.')
                    }
                    if (env.BRANCH_NAME != 'main') {
                        error('Helm deploy jobs are restricted to the main branch only.')
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Helm deploy') {
            steps {
                withCredentials([
                    string(credentialsId: 'digital-ocean-pat', variable: 'DIGITALOCEAN_ACCESS_TOKEN'),
                    string(credentialsId: 'digital-ocean-k8s-cluster', variable: 'DIGITALOCEAN_K8S_CLUSTER')
                ]) {
                    sh 'make helm-upgrade-ci'
                }
            }
        }
    }
}
