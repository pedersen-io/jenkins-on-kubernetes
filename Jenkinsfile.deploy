pipeline {
    agent {
        label 'build-jenkins-base'
    }

    triggers {
        githubPush()
    }

    options {
        skipDefaultCheckout true
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        PROJECT_DIR = '.'
        DEPLOY_ALLOWED = 'false'
    }

    stages {
        stage('Guard: allow manual deploys or tag-triggered deploys') {
            steps {
                script {
                    def isManual = !currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').isEmpty()
                    def isTagBuild = env.TAG_NAME?.trim()

                    if (isTagBuild) {
                        env.DEPLOY_ALLOWED = 'true'
                        echo "Tag-triggered deploy detected for ${env.TAG_NAME}."
                        return
                    }

                    if (isManual) {
                        env.DEPLOY_ALLOWED = 'true'
                        echo "Manual deploy allowed from branch ${env.BRANCH_NAME}."
                        return
                    }

                    currentBuild.description = 'Deploy skipped: run manually from any branch or use a tag build.'
                    echo 'Deploy skipped: only manual runs or tag-triggered builds are allowed.'
                }
            }
        }

        stage('Checkout') {
            when {
                expression { env.DEPLOY_ALLOWED == 'true' }
            }
            steps {
                dir("${env.PROJECT_DIR}") {
                    checkout scm
                }
            }
        }

        stage('Helm deploy') {
            when {
                expression { env.DEPLOY_ALLOWED == 'true' }
            }
            steps {
                script {
                    def digitalOceanPatCredentialsId = env.DIGITALOCEAN_PAT_CREDENTIALS_ID ?: 'digital-ocean-pat'
                    def digitalOceanClusterCredentialsId = env.DIGITALOCEAN_CLUSTER_CREDENTIALS_ID ?: 'digital-ocean-k8s-cluster'

                    withCredentials([
                        string(credentialsId: digitalOceanPatCredentialsId, variable: 'DIGITALOCEAN_ACCESS_TOKEN'),
                        string(credentialsId: digitalOceanClusterCredentialsId, variable: 'DIGITALOCEAN_K8S_CLUSTER')
                    ]) {
                        dir("${env.PROJECT_DIR}") {
                            sh 'make helm-upgrade-ci'
                        }
                    }
                }
            }
        }
    }
}
